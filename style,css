* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #050505;
    color: white;
    font-family: Arial, Helvetica, sans-serif;
    overflow-x: hidden;
}


/* =========================
   BLURRED BLACK + WHITE BG
   ========================= */

body::before {
    content: "";
    position: fixed;
    inset: -100px;

    z-index: -2;

    background:
        radial-gradient(
            circle at 20% 30%,
            rgba(255, 255, 255, 0.22),
            transparent 25%
        ),
        radial-gradient(
            circle at 80% 20%,
            rgba(255, 255, 255, 0.16),
            transparent 28%
        ),
        radial-gradient(
            circle at 65% 75%,
            rgba(255, 255, 255, 0.20),
            transparent 30%
        ),
        radial-gradient(
            circle at 15% 85%,
            rgba(255, 255, 255, 0.12),
            transparent 25%
        ),
        #030303;

    filter: blur(70px);
    transform: scale(1.15);
}


/* DARK OVERLAY */

body::after {
    content: "";
    position: fixed;
    inset: 0;

    z-index: -1;

    background: rgba(0, 0, 0, 0.45);

    pointer-events: none;
}


/* =========================
   NAVIGATION
   ========================= */

nav {
    position: fixed;
    top: 0;
    left: 0;

    width: 100%;
    height: 70px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 5%;

    background: rgba(5, 5, 5, 0.65);

    border-bottom: 1px solid #222;

    backdrop-filter: blur(15px);

    z-index: 100;
}

.logo {
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 5px;
}

.nav-links {
    display: flex;
    gap: 30px;
}

.nav-links a {
    color: #aaa;
    text-decoration: none;

    font-size: 14px;

    transition: 0.3s;
}

.nav-links a:hover {
    color: white;
}


/* =========================
   HERO
   ========================= */

.hero {
    min-height: 100vh;

    display: flex;
    flex-direction: column;

    justify-content: center;
    align-items: center;

    text-align: center;

    position: relative;

    padding: 140px 20px 60px;

    background: rgba(0, 0, 0, 0.18);
}

.warning {
    position: absolute;

    top: 105px;

    width: 90%;
    max-width: 900px;

    color: #aaa;

    font-size: 13px;
    letter-spacing: 3px;

    text-transform: uppercase;

    line-height: 1.6;

    text-shadow:
        0 0 15px rgba(255,255,255,0.15);
}

.welcome {
    font-size: 12px;

    letter-spacing: 7px;

    color: #777;

    margin-top: 65px;
    margin-bottom: 45px;
}

.hero h1 {
    font-size: clamp(90px, 15vw, 220px);

    letter-spacing: 15px;

    font-weight: 900;

    margin-left: 15px;

    text-shadow:
        0 0 20px rgba(255,255,255,0.12),
        0 0 60px rgba(255,255,255,0.04);
}

.subtitle {
    margin-top: 30px;

    font-size: 14px;

    letter-spacing: 5px;

    color: #999;
}


/* =========================
   BUTTON
   ========================= */

.join-button {
    margin-top: 45px;

    padding: 17px 42px;

    background: rgba(0,0,0,0.35);

    border: 1px solid #555;

    color: white;

    font-size: 14px;

    letter-spacing: 4px;

    cursor: pointer;

    transition:
        transform 0.25s ease,
        background 0.25s ease,
        color 0.25s ease,
        border-color 0.25s ease,
        box-shadow 0.25s ease;
}

.join-button:hover {
    transform: scale(1.12);

    background: white;

    color: black;

    border-color: white;

    box-shadow:
        0 0 30px rgba(255,255,255,0.15);
}


/* =========================
   SECTIONS
   ========================= */

section {
    min-height: 100vh;

    padding: 120px 8%;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;
}

.section-title {
    font-size: 42px;

    letter-spacing: 8px;

    margin-bottom: 70px;

    text-shadow:
        0 0 25px rgba(255,255,255,0.08);
}


/* =========================
   MEMBERS
   ========================= */

.members {
    width: 100%;
    max-width: 1100px;

    display: grid;

    grid-template-columns:
        repeat(auto-fit, minmax(250px, 1fr));

    gap: 25px;
}

.member {
    padding: 45px 25px;

    border: 1px solid #222;

    background: rgba(5,5,5,0.55);

    backdrop-filter: blur(15px);

    transition:
        transform 0.3s ease,
        border-color 0.3s ease,
        background 0.3s ease;
}

.member:hover {
    transform: translateY(-8px);

    border-color: #666;

    background: rgba(20,20,20,0.65);
}

.member h3 {
    font-size: 25px;

    letter-spacing: 3px;

    margin-bottom: 15px;
}

.member p {
    color: #888;

    font-size: 13px;

    line-height: 1.6;
}


/* =========================
   ENEMYS
   ========================= */

#enemys {
    background: rgba(0,0,0,0.12);
}

.enemy-columns {
    width: 100%;
    max-width: 1100px;

    display: grid;

    grid-template-columns:
        repeat(auto-fit, minmax(300px, 1fr));

    gap: 60px;
}

.enemy-group {
    width: 100%;
}

.enemy-group > h3 {
    font-size: 18px;

    letter-spacing: 4px;

    margin-bottom: 25px;

    color: #aaa;
}

.enemy-card {
    padding: 25px;

    margin-bottom: 15px;

    background: rgba(5,5,5,0.55);

    border: 1px solid #222;

    backdrop-filter: blur(15px);

    text-align: left;

    transition:
        transform 0.3s ease,
        border-color 0.3s ease,
        background 0.3s ease;
}

.enemy-card:hover {
    transform: translateX(8px);

    border-color: #555;

    background: rgba(20,20,20,0.65);
}

.enemy-card h4 {
    font-size: 18px;

    letter-spacing: 2px;

    margin-bottom: 8px;
}

.enemy-card p {
    color: #777;

    font-size: 13px;

    line-height: 1.6;
}


/* =========================
   JOIN
   ========================= */

.join-section {
    background: rgba(0,0,0,0.12);
}

.join-section p {
    max-width: 550px;

    color: #888;

    line-height: 1.8;

    margin-bottom: 5px;
}


/* =========================
   POPUP
   ========================= */

.popup-overlay {
    position: fixed;

    inset: 0;

    display: none;

    align-items: center;

    justify-content: center;

    background: rgba(0,0,0,0.78);

    backdrop-filter: blur(10px);

    z-index: 999;
}

.popup-overlay.active {
    display: flex;
}

.popup {
    position: relative;

    width: 90%;
    max-width: 450px;

    padding: 50px 35px;

    text-align: center;

    background: rgba(8,8,8,0.9);

    border: 1px solid #444;

    box-shadow:
        0 0 50px rgba(255,255,255,0.05);

    animation: popupIn 0.25s ease;
}

.popup h2 {
    font-size: 28px;

    letter-spacing: 5px;

    margin-bottom: 20px;
}

.popup p {
    color: #999;

    font-size: 15px;
}

.close-popup {
    position: absolute;

    top: 10px;
    right: 18px;

    background: none;

    border: none;

    color: #777;

    font-size: 28px;

    cursor: pointer;

    transition: 0.2s;
}

.close-popup:hover {
    color: white;
}

@keyframes popupIn {
    from {
        opacity: 0;
        transform: scale(0.9);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}


/* =========================
   FOOTER
   ========================= */

footer {
    padding: 30px;

    text-align: center;

    border-top: 1px solid #1c1c1c;

    color: #555;

    font-size: 12px;

    letter-spacing: 2px;

    background: rgba(0,0,0,0.3);
}


/* =========================
   MOBILE
   ========================= */

@media (max-width: 700px) {

    .nav-links {
        gap: 15px;
    }

    .nav-links a {
        font-size: 11px;
    }

    .hero h1 {
        letter-spacing: 7px;
    }

    .welcome {
        letter-spacing: 4px;
    }

    .warning {
        font-size: 10px;

        letter-spacing: 2px;

        top: 100px;
    }
}
